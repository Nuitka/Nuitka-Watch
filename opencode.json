{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "RELEASE_REVIEW_WORKFLOW.md"],
  "plugin": ["@opencode-ai/plugin"],
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git blame *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "./nuitka-release.sh *", "effect": "allow" },
    { "action": "shell", "resource": "./pypi-update.sh *", "effect": "allow" },
    { "action": "shell", "resource": "./run-watch.sh *", "effect": "allow" },
    { "action": "shell", "resource": "./auto-stage.sh *", "effect": "allow" },
    { "action": "shell", "resource": "pipenv *", "effect": "allow" },
    { "action": "shell", "resource": "python*", "effect": "allow" },
    { "action": "shell", "resource": "git rm *", "effect": "ask" },
    { "action": "shell", "resource": "git add *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout *", "effect": "ask" },
    { "action": "shell", "resource": "git stash *", "effect": "ask" },
    { "action": "shell", "resource": "git reset *", "effect": "deny" },
    { "action": "shell", "resource": "git commit *", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "deny" }
  ]
}
